<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration for FlyTab.

  Google Play requires cleartext traffic to be scoped rather than globally
  permitted via android:usesCleartextTraffic="true".

  All public internet traffic (flywhere.app, AWC weather proxy, NOTAM API)
  already uses HTTPS — the base-config enforces this for everything not listed
  below. Cleartext is permitted ONLY for the local devices FlyTab communicates
  with directly over the cockpit or home Wi-Fi network:

    localhost / 127.0.0.1     NanoHTTPD internal server (port 9090)
    192.168.1.x               Home LAN — Stratux, Pi engine monitor, tile server
    192.168.10.x              Stratux access-point subnet (default Stratux AP)
    192.168.0.x               Alternative home LAN subnet
    10.0.0.x                  Some ISP/router 10.x subnets

  Android does not support CIDR notation in this file; specific addresses are
  enumerated below. Add or edit entries to match your network configuration.
  Tailscale (100.64.0.0/10) users: add your device's Tailscale IP here.
-->
<network-security-config>

    <!-- HTTPS enforced for all public internet traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext permitted for local aviation hardware only -->
    <domain-config cleartextTrafficPermitted="true">

        <!-- Capacitor WebViewAssetLoader / NanoHTTPD (localhost:9090) -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>

        <!-- 192.168.1.x — typical home LAN -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.1.81</domain>   <!-- FitPC / NOTAM proxy -->
        <domain includeSubdomains="false">192.168.1.82</domain>
        <domain includeSubdomains="false">192.168.1.100</domain>
        <domain includeSubdomains="false">192.168.1.212</domain>  <!-- Stratux -->

        <!-- 192.168.10.x — Stratux access-point subnet (Stratux default AP mode) -->
        <domain includeSubdomains="false">192.168.10.1</domain>
        <domain includeSubdomains="false">192.168.10.2</domain>
        <domain includeSubdomains="false">192.168.10.212</domain>

        <!-- 192.168.0.x — alternative home LAN -->
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.0.212</domain>

        <!-- 10.x.x.x — some routers / ISP CPE use this range -->
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.2</domain>

    </domain-config>

</network-security-config>
