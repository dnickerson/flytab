                { "title": "Magnetos", "response": "LEFT - RIGHT" },
                { "title": "Starter", "response": "ON" },
                { "title": "Autopilot", "response": "OFF" }
              ]
            },
            {
              "name": "Before Landing",
              "items": [
                { "title": "Fuel Selector", "response": "OFF" },
                { "title": "Squawk", "response": "7700" },
                { "title": "ELT", "response": "ACTIVE" }
              ]
            }
          ]
        }
      ]
    }
  ]
