                { "title": "Radio Breaker", "response": "IN" },
                { "title": "Portable Radio", "response": "CONNECT HEADSET" },
                { "title": "Squawk", "response": "7600" },
                { "title": "Navigation", "response": "FLY TO LAST CLEARANCE", "note": "Start approach at the time in the flight plan" }
              ]
            }
          ]
        },
        {
          "name": "Engine",
          "checklists": [
            {
              "name": "Engine Failure",
              "items": [
                { "title": "Find suitable field", "response": "", "type": "info", "note": "Turn left, 74 KIAS 10:1 glide\nAlt    Dist   Time\n2K     3.5 nm  3 min\n4K     7.5 nm  6 min\n6K     11 nm   9 min\n8K     15 nm   12 min\n10K    18 nm   15 min" },
                { "title": "Mixture", "response": "FULL RICH" },
                { "title": "Best Glide", "response": "TRIM FOR 75 KIAS" },
                { "title": "Airport or Field", "response": "SELECT", "note": "GPS 175 TWIST OUTER KNOB - NEAREST - DIRECT TO - ACTIVATE" },
                { "title": "Fuel Selector", "response": "TURN TO OTHER TANK" },
